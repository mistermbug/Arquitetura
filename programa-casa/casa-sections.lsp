;;; Sections and roof representation, all coordinates in millimetres.
(defun cd:polyline (points closed layer id)
 (cg:mk (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 layer)
  '(100 . "AcDbPolyline") (cons 90 (length points)) (cons 70 (if closed 1 0)))
  (mapcar '(lambda (p) (cons 10 p)) points)) id))
(defun cd:intervals (poly y / points a b xs result)
 (setq points (append poly (list (car poly))) xs nil result nil)
 (while (cdr points)
  (setq a (car points) b (cadr points))
  (if (and (equal (car a) (car b) 0.01) (<= (min (cadr a) (cadr b)) y) (> (max (cadr a) (cadr b)) y))
   (setq xs (cons (car a) xs)))
  (setq points (cdr points)))
 (setq xs (vl-sort xs '<))
 (while (cdr xs) (setq result (append result (list (list (car xs) (cadr xs)))) xs (cddr xs))) result)
(defun cd:sections (model tx yy / roof poly house x0 x1 y0 y1 ht rt ph pt cutY spans pair lo hi item a b w op gap c sill top left right room facadeY)
 (setq roof (cg:get "roof" model) poly (cg:get "outline" roof) house (cg:get "house_bounds" model)
  x0 (nth 0 house) y0 (nth 1 house) x1 (nth 2 house) y1 (nth 3 house)
  ht (cg:get "base_z" roof) rt (cg:get "thickness" roof) ph (cg:get "parapet_height" roof) pt (cg:get "parapet_thickness" roof)
  cutY (+ y0 (* 0.37 (- y1 y0))) yy (- yy ht ph 2000) spans (cd:intervals poly cutY))
 (cg:text (list tx (+ yy ht rt ph 500)) "CORTE A-A | laje de cobertura e platibanda" 200 "CASA_TEXTOS" "SECTION")
 (foreach pair spans
  (setq lo (+ tx (- (car pair) x0)) hi (+ tx (- (cadr pair) x0)))
  (cg:rect (list lo (- yy (cg:get "thickness" (cg:get "slab" model))) hi yy) "CASA_ESTUDO" "SECTION-FLOOR")
  (cg:rect (list lo (+ yy ht) hi (+ yy ht rt)) "CASA_COBERTURA" "SECTION-ROOF")
  (cg:rect (list lo (+ yy ht rt) (+ lo pt) (+ yy ht rt ph)) "CASA_COBERTURA" "SECTION-PARAPET")
  (cg:rect (list (- hi pt) (+ yy ht rt) hi (+ yy ht rt ph)) "CASA_COBERTURA" "SECTION-PARAPET"))
 (foreach item (cg:get "walls" model)
  (setq a (cg:get "start" item) b (cg:get "end" item) w (cg:get "thickness" item) gap nil)
  (if (and (equal (car a) (car b) 0.01) (< (min (cadr a) (cadr b)) cutY) (> (max (cadr a) (cadr b)) cutY))
   (progn
    (foreach op (cg:get "openings" model)
     (if (and (= (cg:get "wall_id" op) (cg:get "id" item))
       (< (abs (- (cadr (cg:get "center" op)) cutY)) (/ (cg:get "width" op) 2))) (setq gap op)))
    (setq left (+ tx (- (car a) x0 (/ w 2))) right (+ left w))
    (if gap
     (progn (setq sill (cg:get "sill" gap) top (+ sill (cg:get "height" gap)))
      (if (> sill 0) (cg:rect (list left yy right (+ yy sill)) "CASA_ESTUDO" "SECTION-WALL"))
      (if (< top ht) (cg:rect (list left (+ yy top) right (+ yy ht)) "CASA_ESTUDO" "SECTION-WALL"))
      (if (= (cg:get "kind" gap) "window") (cg:line (list (/ (+ left right) 2) (+ yy sill)) (list (/ (+ left right) 2) (+ yy top)) "CASA_JANELAS" "SECTION-WINDOW")))
     (cg:rect (list left yy right (+ yy ht)) "CASA_ESTUDO" "SECTION-WALL")))))
 (cg:dim (list tx yy) (list tx (+ yy ht)) (list (- tx 600) yy) "DIM-CEILING")
 (cg:dim (list (+ tx (- x1 x0)) yy) (list (+ tx (- x1 x0)) (+ yy ht rt ph)) (list (+ tx (- x1 x0) 600) yy) "DIM-TOTAL-HEIGHT")
 (cg:text (list tx (- yy 500)) "Laje conceitual 15 cm. Caimento, drenagem e estrutura a dimensionar." 140 "CASA_TEXTOS" "ROOF-NOTE")
 (cg:line (list (- x0 250) cutY) (list (+ x1 250) cutY) "CASA_ESTUDO" "SECTION-MARK")
 (cg:text (list (- x0 500) (+ cutY 150)) "A" 180 "CASA_TEXTOS" "SECTION-MARK")
 (cg:text (list (+ x1 300) (+ cutY 150)) "A" 180 "CASA_TEXTOS" "SECTION-MARK")
 (setq yy (- yy ht rt ph 2000))
 (cg:text (list tx (+ yy ht rt ph 500)) "FACHADA FRONTAL | cobertura com platibanda" 200 "CASA_TEXTOS" "FACADE")
 (cg:rect (list tx yy (+ tx (- x1 x0)) (+ yy ht)) "CASA_ESTUDO" "FACADE")
 (cg:rect (list tx (+ yy ht) (+ tx (- x1 x0)) (+ yy ht rt)) "CASA_COBERTURA" "FACADE-ROOF")
 (cg:rect (list tx (+ yy ht rt) (+ tx (- x1 x0)) (+ yy ht rt ph)) "CASA_COBERTURA" "FACADE-PARAPET")
 (foreach item (cg:get "openings" model)
  (setq a (cg:find-id (cg:get "wall_id" item) (cg:get "walls" model)) c (cg:get "center" item)
   room (cg:find-id (cg:get "room_id" item) (cg:get "rooms" model)))
  (if (and (= (cg:get "wall_role" a) "external")
    (equal (cadr (cg:get "start" a)) (cadr (cg:get "end" a)) 0.01)
    room (> (cadr (cg:get "bounds" room)) (cadr c)))
   (progn (setq w (cg:get "width" item) sill (cg:get "sill" item))
    (cg:rect (list (+ tx (- (car c) x0 (/ w 2))) (+ yy sill)
     (+ tx (- (+ (car c) (/ w 2)) x0)) (+ yy sill (cg:get "height" item))) "CASA_ESTUDO" "FACADE-OPENING"))))
 (princ))
(princ)
