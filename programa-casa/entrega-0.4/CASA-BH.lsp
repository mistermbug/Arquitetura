;;; CASA BH - AutoCAD 2027 / AutoLISP. ASCII source for legacy LISPSYS.
(vl-load-com)
(setq *casa-version* "0.4.0")
(setq *casa-fields* '("lot_width" "lot_depth" "house_width" "wall_internal" "wall_external" "height" "corridor"
  "bedrooms" "bathrooms" "living" "kitchens" "laundry" "dining" "office" "front" "rear" "side" "seed" "occupants" "parking" "layout" "integration" "north"))
(if (not *casa-input*)
 (setq *casa-input* '(("lot_width" . "12") ("lot_depth" . "30") ("house_width" . "9")
  ("wall_internal" . "0.15") ("wall_external" . "0.20") ("height" . "2.8") ("corridor" . "1.2") ("bedrooms" . "3")
  ("bathrooms" . "1") ("living" . "1") ("kitchens" . "1") ("laundry" . "1")
  ("dining" . "1") ("office" . "0") ("front" . "6.5") ("rear" . "3") ("side" . "1.5")
  ("seed" . "42") ("furniture" . "1"))))
(foreach pair '(("wall_internal" . "0.15") ("wall_external" . "0.20") ("occupants" . "4") ("parking" . "1") ("layout" . "0") ("integration" . "0") ("north" . "0") ("terrace" . "1"))
 (if (not (assoc (car pair) *casa-input*)) (setq *casa-input* (cons pair *casa-input*))))
(defun cg:ensure-core () T)
(defun cg:accept (/ key raw value params inputs err lengthkeys)
 (setq params nil inputs nil err nil lengthkeys '("lot_width" "lot_depth" "house_width" "wall_internal" "wall_external" "height" "corridor" "front" "rear" "side"))
 (foreach key *casa-fields*
  (setq raw (get_tile key) value (distof (vl-string-translate "," "." raw) 2))
  (setq inputs (cons (cons key raw) inputs))
  (if value
   (setq params (cons (cons key (if (member key lengthkeys) (* value 1000.0) value)) params))
   (setq err (strcat "Preencha um numero valido em: " key))))
 (setq params (cons (cons "terrace" (atoi (get_tile "terrace"))) params) inputs (cons (cons "terrace" (get_tile "terrace")) inputs))
 (setq params (cons (cons "furniture" (atoi (get_tile "furniture"))) params)
       inputs (cons (cons "furniture" (get_tile "furniture")) inputs))
 (if (not err) (setq err (cg:validate-input params)))
 (if err (set_tile "error" err)
  (progn (setq *casa-input* inputs *casa-params* params) (done_dialog 1))))
(defun cg:form (/ dlg result pair)
 (setq dlg (load_dialog (cg:embedded-dialog)))
 (if (and (> dlg 0) (new_dialog "casa_form" dlg))
  (progn
   (start_list "layout") (mapcar 'add_list '("Aleatoria" "Social na frente" "Social no fundo" "Nucleo de convivencia")) (end_list)
   (start_list "integration") (mapcar 'add_list '("Variar" "Aberta" "Semiaberta" "Fechada")) (end_list)
   (foreach pair *casa-input* (set_tile (car pair) (cdr pair)))
   (action_tile "accept" "(cg:accept)")
   (action_tile "cancel" "(done_dialog 0)")
   (setq result (start_dialog)) (progn (unload_dialog dlg) (if *casa-temp-dcl* (vl-file-delete *casa-temp-dcl*))) (= result 1))
  (progn (if (> dlg 0) (progn (unload_dialog dlg) (if *casa-temp-dcl* (vl-file-delete *casa-temp-dcl*)))) (alert "Nao foi possivel abrir casa.dcl.") nil)))
(defun cg:escape (str / i ch out)
 (setq i 1 out "")
 (repeat (strlen str)
  (setq ch (substr str i 1) out (strcat out
   (cond ((= ch "\"") "\\\"") ((= ch "\\") "\\\\") ((= ch (chr 10)) "\\n")
    ((= ch (chr 13)) "\\r") ((= ch (chr 9)) "\\t") (T ch))) i (1+ i))) out)
(defun cg:join (items separator / out item)
 (setq out "") (foreach item items (setq out (strcat out (if (= out "") "" separator) item))) out)
(defun cg:number-json (value / text)
 (setq text (rtos value 2 6))
 (if (= (substr text 1 1) ".") (setq text (strcat "0" text)))
 (if (= (substr text 1 2) "-.") (setq text (strcat "-0" (substr text 2)))) text)
(defun cg:json (value / pair out)
 (cond ((eq value 'cj:true) "true") ((eq value 'cj:false) "false") ((eq value 'cj:null) "null") ((null value) "[]")
  ((= (type value) 'STR) (strcat "\"" (cg:escape value) "\""))
  ((numberp value) (cg:number-json value))
  ((and (listp value) (listp (car value)) (= (type (caar value)) 'STR))
   (setq out nil)
   (foreach pair value (setq out (append out (list (strcat (cg:json (car pair)) ":" (cg:json (cdr pair)))))))
   (strcat "{" (cg:join out ",") "}"))
  ((listp value) (strcat "[" (cg:join (mapcar 'cg:json value) ",") "]"))
  (T "null")))
(defun cg:write-json (model file / stream)
 (setq stream (open file "w"))
 (if stream (progn (write-line (cg:json model) stream) (close stream) T) nil))
(defun cg:tag (entity id / data)
 (if entity
  (progn (setq data (entget entity))
   (entmod (append data (list (list -3 (list "CASA_BH" (cons 1000 *cg-pid*) (cons 1000 id)))))) entity)))
(defun cg:mk (data id / entity)
 (setq entity (entmakex data))
 (if (not entity) (progn (princ "\nFalha ao criar entidade. Operacao cancelada.") (exit)))
 (cg:tag entity id))
(defun cg:layer (name color)
 (if (not (tblsearch "LAYER" name))
  (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord")
   (cons 2 name) '(70 . 0) (cons 62 color) '(6 . "Continuous")))))
(defun cg:line (a b layer id)
 (cg:mk (list '(0 . "LINE") (cons 8 layer) (cons 10 (append a '(0.0))) (cons 11 (append b '(0.0)))) id))
(defun cg:rect (box layer id / x0 y0 x1 y1)
 (setq x0 (nth 0 box) y0 (nth 1 box) x1 (nth 2 box) y1 (nth 3 box))
 (cg:mk (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 layer)
  '(100 . "AcDbPolyline") '(90 . 4) '(70 . 1)
  (cons 10 (list x0 y0)) (cons 10 (list x1 y0)) (cons 10 (list x1 y1)) (cons 10 (list x0 y1))) id))
(defun cg:text (point str size layer id)
 (cg:mk (list '(0 . "TEXT") (cons 8 layer) (cons 10 (append point '(0.0))) (cons 40 size)
  (cons 1 str) '(50 . 0.0) '(7 . "Standard")) id))
(defun cg:dim (a b point id)
 (setvar "CLAYER" "CASA_COTAS")
 (command-s "_.DIMLINEAR" "_non" (append a '(0.0)) "_non" (append b '(0.0)) "_non" (append point '(0.0)))
 (cg:tag (entlast) id))
(defun cg:wall-segment (start end lo hi thick horizontal id / x y)
 (if (> (- hi lo) 0.1)
  (if horizontal
   (cg:rect (list (+ (car start) lo) (- (cadr start) (/ thick 2.0))
    (+ (car start) hi) (+ (cadr start) (/ thick 2.0))) "CASA_PAREDES" id)
   (cg:rect (list (- (car start) (/ thick 2.0)) (+ (cadr start) lo)
    (+ (car start) (/ thick 2.0)) (+ (cadr start) hi)) "CASA_PAREDES" id))))
(defun cg:draw-wall (wall openings / a b horiz len intervals opening at current gap thick id)
 (setq a (cg:get "start" wall) b (cg:get "end" wall) horiz (equal (cadr a) (cadr b) 0.01)
  len (distance a b) thick (cg:get "thickness" wall) id (cg:get "id" wall) intervals nil current 0.0)
 (foreach opening openings
  (if (= (cg:get "wall_id" opening) id)
   (progn
    (setq at (distance a (cg:get "center" opening)))
    (setq intervals (cons (list (- at (/ (cg:get "width" opening) 2.0))
      (+ at (/ (cg:get "width" opening) 2.0))) intervals)))))
 (setq intervals (vl-sort intervals '(lambda (u v) (< (car u) (car v)))))
 (foreach gap intervals
  (cg:wall-segment a b current (car gap) thick horiz id)
  (setq current (cadr gap)))
 (cg:wall-segment a b current len thick horiz id))
(defun cg:find-id (id records / result record)
 (setq result nil) (foreach record records (if (= id (cg:get "id" record)) (setq result record))) result)
(defun cg:draw-opening (opening walls / wall c width horiz a b h id hinge tip angle0 angle1 roomside)
 (setq wall (cg:find-id (cg:get "wall_id" opening) walls) c (cg:get "center" opening)
  width (cg:get "width" opening) h (/ (cg:get "thickness" wall) 2.0)
  horiz (equal (cadr (cg:get "start" wall)) (cadr (cg:get "end" wall)) 0.01)
  id (cg:get "id" opening))
 (if horiz
  (setq a (list (- (car c) (/ width 2.0)) (cadr c)) b (list (+ (car c) (/ width 2.0)) (cadr c)))
  (setq a (list (car c) (- (cadr c) (/ width 2.0))) b (list (car c) (+ (cadr c) (/ width 2.0)))))
 (if (= (cg:get "kind" opening) "window")
  (progn
   (cg:line a b "CASA_JANELAS" id)
   (if horiz
    (progn (cg:line (list (car a) (- (cadr a) h)) (list (car b) (- (cadr b) h)) "CASA_JANELAS" id)
     (cg:line (list (car a) (+ (cadr a) h)) (list (car b) (+ (cadr b) h)) "CASA_JANELAS" id))
    (progn (cg:line (list (- (car a) h) (cadr a)) (list (- (car b) h) (cadr b)) "CASA_JANELAS" id)
     (cg:line (list (+ (car a) h) (cadr a)) (list (+ (car b) h) (cadr b)) "CASA_JANELAS" id))))
  (progn
   (setq hinge a)
   (if horiz
    (setq tip (list (car a) (+ (cadr a) width)) angle0 0.0 angle1 (/ pi 2.0))
    (progn
     (setq roomside (cg:find-id (cg:get "room_id" opening) (cg:get "rooms" *cg-drawing-model*)))
     (if (< (nth 0 (cg:get "bounds" roomside)) (car c))
      (setq tip (list (- (car a) width) (cadr a)) angle0 (/ pi 2.0) angle1 pi)
      (setq tip (list (+ (car a) width) (cadr a)) angle0 0.0 angle1 (/ pi 2.0)))))
   (cg:line hinge tip "CASA_PORTAS" id)
   (cg:mk (list '(0 . "ARC") '(8 . "CASA_PORTAS") (cons 10 (append hinge '(0.0)))
    (cons 40 width) (cons 50 angle0) (cons 51 angle1)) id))))
(defun cg:draw-furniture (item / box kind id)
 (setq box (cg:get "bounds" item) kind (cg:get "kind" item) id (cg:get "id" item))
 (cg:rect box "CASA_MOVEIS" id)
 (cond
  ((= kind "bed")
   (cg:rect (list (+ (nth 0 box) 100) (- (nth 3 box) 500) (- (nth 2 box) 100) (- (nth 3 box) 100)) "CASA_MOVEIS" id))
  ((= kind "sofa")
   (cg:rect (list (+ (nth 0 box) 100) (+ (nth 1 box) 100) (- (nth 2 box) 100) (- (nth 3 box) 200)) "CASA_MOVEIS" id))
  ((= kind "shower")
   (cg:line (list (nth 0 box) (nth 1 box)) (list (nth 2 box) (nth 3 box)) "CASA_MOVEIS" id))))
(defun cg:draw-model (model / site house walls openings rooms item box x0 y0 x1 y1 tx ty lineY i total clearbox ht wt it)
 (setq *cg-drawing-model* model site (cg:get "site_bounds" model) house (cg:get "house_bounds" model)
  walls (cg:get "walls" model) openings (cg:get "openings" model) rooms (cg:get "rooms" model)
  x0 (nth 0 house) y0 (nth 1 house) x1 (nth 2 house) y1 (nth 3 house))
 (foreach item '(("CASA_LOTE" 8) ("CASA_PAREDES" 7) ("CASA_PORTAS" 2) ("CASA_JANELAS" 4)
   ("CASA_MOVEIS" 3) ("CASA_TEXTOS" 7) ("CASA_COTAS" 6) ("CASA_ESTUDO" 8)) (cg:layer (car item) (cadr item)))
 (cg:rect site "CASA_LOTE" "SITE")
 (foreach item walls (cg:draw-wall item openings))
 (foreach item openings (cg:draw-opening item walls))
 (foreach item (cg:get "furniture" model) (cg:draw-furniture item))
 (foreach item rooms
  (setq box (cg:get "bounds" item))
  (if (/= (cg:get "kind" item) "corridor")
   (progn
    (cg:text (list (+ (nth 0 box) (if (> (nth 0 box) (/ (+ x0 x1) 2.0)) 1100 150)) (+ (nth 1 box) 350))
     (strcat (cg:get "id" item) " " (cg:get "name" item)) 150 "CASA_TEXTOS" (cg:get "id" item))
    (cg:text (list (+ (nth 0 box) (if (> (nth 0 box) (/ (+ x0 x1) 2.0)) 1100 150)) (+ (nth 1 box) 120))
     (strcat (rtos (cg:get "net_area_m2" item) 2 2) " m2") 120 "CASA_TEXTOS" (cg:get "id" item))
    (if (equal (nth 0 box) (+ x0 (cg:get "thickness" (car walls))) 0.01)
     (cg:dim (list (nth 0 box) (nth 1 box)) (list (nth 0 box) (nth 3 box))
      (list (- x0 600) (/ (+ (nth 1 box) (nth 3 box)) 2.0)) "DIM-ROOM")))))
 (foreach item (list (nth 0 rooms) (nth 1 rooms) (cg:find-id "CIRC" rooms))
  (setq box (cg:get "bounds" item))
  (cg:dim (list (nth 0 box) y0) (list (nth 2 box) y0)
   (list (nth 0 box) (- y0 450)) "DIM-CLEAR-W"))
 (cg:dim (list x0 y0) (list x1 y0) (list x0 (- y0 1000)) "DIM-HOUSE-W")
 (cg:dim (list x0 y0) (list x0 y1) (list (- x0 1300) y0) "DIM-HOUSE-D")
 (cg:dim (list (nth 0 site) (nth 1 site)) (list (nth 2 site) (nth 1 site))
  (list (nth 0 site) (- (nth 1 site) 1500)) "DIM-SITE-W")
 (cg:dim (list (nth 2 site) (nth 1 site)) (list (nth 2 site) (nth 3 site))
  (list (+ (nth 2 site) 1200) (nth 1 site)) "DIM-SITE-D")
 (setq tx (+ (nth 2 site) 3500) ty (nth 3 site) lineY (- ty 800) total 0.0)
 (cg:text (list tx ty) "CASA BH | ESTUDO PRELIMINAR" 300 "CASA_TEXTOS" "TITLE")
 (cg:text (list tx (- ty 450)) (strcat "Projeto " (cg:get "project_id" model) " | seed " (itoa (fix (cg:get "seed" model)))) 180 "CASA_TEXTOS" "TITLE")
 (foreach item rooms
  (cg:text (list tx lineY) (strcat (cg:get "id" item) " - " (cg:get "name" item) " : "
    (rtos (cg:get "net_area_m2" item) 2 2) " m2") 180 "CASA_TEXTOS" "SCHEDULE")
  (setq lineY (- lineY 320) total (+ total (cg:get "net_area_m2" item))))
 (cg:text (list tx (- lineY 150)) (strcat "Area util: " (rtos total 2 2) " m2 | Construida geometrica: "
   (rtos (cg:get "gross_area_m2" model) 2 2) " m2") 180 "CASA_TEXTOS" "SCHEDULE")
 (setq lineY (- lineY 600))
 (foreach item '("Nao aprovado pela PBH. Faixas livres sao parametros de ensaio."
   "Cotas em metros; geometria em milimetros. Terreno plano hipotetico."
   "Norte, levantamento, cobertura, estrutura e instalacoes: a definir."
   "Mobiliario esquematico. Operacao e acessibilidade nao verificadas."
   "Revit: exportar snapshot gerado; alteracoes manuais CAD nao seguem.")
  (cg:text (list tx lineY) item 160 "CASA_TEXTOS" "NOTES") (setq lineY (- lineY 300)))
 ;; Schematic section and facade, deliberately not construction details.
 (setq lineY (- lineY 4500) ht (cg:get "height" (car walls)) wt (cg:get "thickness" (car walls)) it (cg:opt "wall_internal" model wt))
 (cg:text (list tx (+ lineY ht 550)) "CORTE A-A ESQUEMATICO | cobertura a definir" 220 "CASA_TEXTOS" "SECTION")
 (cg:rect (list tx (- lineY 150) (+ tx (- x1 x0)) lineY) "CASA_ESTUDO" "SECTION")
 (cg:rect (list tx lineY (+ tx wt) (+ lineY ht)) "CASA_ESTUDO" "SECTION")
 (cg:rect (list (- (+ tx (- x1 x0)) wt) lineY (+ tx (- x1 x0)) (+ lineY ht)) "CASA_ESTUDO" "SECTION")
 (setq clearbox (cg:get "bounds" (cg:find-id "CIRC" rooms)))
 (cg:rect (list (+ tx (- (nth 0 clearbox) x0 it)) lineY (+ tx (- (nth 0 clearbox) x0)) (+ lineY ht)) "CASA_ESTUDO" "SECTION")
 (cg:rect (list (+ tx (- (nth 2 clearbox) x0)) lineY (+ tx (- (nth 2 clearbox) x0) it) (+ lineY ht)) "CASA_ESTUDO" "SECTION")
 (cg:line (list tx (+ lineY ht)) (list (+ tx (- x1 x0)) (+ lineY ht)) "CASA_ESTUDO" "SECTION")
 (cg:dim (list tx lineY) (list tx (+ lineY ht)) (list (- tx 650) lineY) "DIM-HEIGHT")
 (cg:line (list (- x0 300) (+ y0 1600)) (list (+ x1 300) (+ y0 1600)) "CASA_ESTUDO" "SECTION-MARK")
 (cg:text (list (- x0 350) (+ y0 1850)) "A" 200 "CASA_TEXTOS" "SECTION-MARK")
 (cg:text (list (+ x1 200) (+ y0 1850)) "A" 200 "CASA_TEXTOS" "SECTION-MARK")
 (setq lineY (- lineY 5000))
 (cg:text (list tx (+ lineY ht 550)) "FACHADA FRONTAL ESQUEMATICA" 220 "CASA_TEXTOS" "FACADE")
 (cg:rect (list tx lineY (+ tx (- x1 x0)) (+ lineY ht)) "CASA_ESTUDO" "FACADE")
 (cg:rect (list (+ tx (/ (- (- x1 x0) 900) 2.0)) lineY
  (+ tx (/ (+ (- x1 x0) 900) 2.0)) (+ lineY 2100)) "CASA_ESTUDO" "FACADE")
 (princ))
(defun cg:store-model (model / dictionary entry str chunks i record)
 (setq entry (dictsearch (namedobjdict) "CASA_BH_MODELS"))
 (if entry (setq dictionary (cdr (assoc -1 entry)))
  (progn (setq dictionary (entmakex '((0 . "DICTIONARY") (100 . "AcDbDictionary") (281 . 1))))
   (dictadd (namedobjdict) "CASA_BH_MODELS" dictionary)))
 (setq str (cg:json model) chunks nil i 1)
 (while (<= i (strlen str)) (setq chunks (append chunks (list (cons 1 (substr str i 240))))) (setq i (+ i 240)))
 (setq record (entmakex (append '((0 . "XRECORD") (100 . "AcDbXrecord") (280 . 1)) chunks)))
 (if (not (dictadd dictionary (cg:get "project_id" model) record))
  (progn (princ "\nFalha ao gravar snapshot do projeto.") (exit))))
(defun cg:restore-vars (values / pair)
 (foreach pair values (setvar (car pair) (cdr pair))))
(defun cg:commit (model / *error* saved undoStarted ucsChanged key *cg-pid* *cg-drawing-model*)
 (setq saved nil undoStarted nil ucsChanged nil *cg-pid* (cg:get "project_id" model))
 (foreach key '("CMDECHO" "OSMODE" "CLAYER" "DIMTXT" "DIMASZ" "DIMSCALE" "DIMDEC" "DIMLUNIT" "DIMLFAC" "DIMZIN" "DIMPOST" "DIMTAD" "DIMTIH" "DIMTOH" "DIMGAP" "DIMEXE" "DIMEXO" "DIMTSZ")
  (setq saved (cons (cons key (getvar key)) saved)))
 (defun *error* (message)
  (if ucsChanged (command-s "_.UCS" "_Previous"))
  (cg:restore-vars saved)
  (if undoStarted (progn (command-s "_.UNDO" "_End") (command-s "_.U")))
  (princ (strcat "\nGeracao cancelada: " message)) (princ))
 (if (or (/= (getvar "INSUNITS") 4) (/= (getvar "TILEMODE") 1))
  (progn (princ "\nUse a aba Modelo e desenho em milimetros (INSUNITS=4). Nenhuma entidade criada.") nil)
  (progn
   (command-s "_.UNDO" "_Begin") (setq undoStarted T)
   (command-s "_.UCS" "_World") (setq ucsChanged T)
   (regapp "CASA_BH")
   (setvar "CMDECHO" 0) (setvar "OSMODE" 0)
   (setvar "DIMTXT" 140) (setvar "DIMASZ" 120) (setvar "DIMSCALE" 1.0)
   (setvar "DIMDEC" 2) (setvar "DIMLUNIT" 2) (setvar "DIMLFAC" 0.001)
   (setvar "DIMZIN" 0) (setvar "DIMPOST" "<>")
   (setvar "DIMTAD" 1) (setvar "DIMTIH" 0) (setvar "DIMTOH" 0)
   (setvar "DIMGAP" 60) (setvar "DIMEXE" 100) (setvar "DIMEXO" 80) (setvar "DIMTSZ" 70)
   (cg:draw-model model) (cg:store-model model)
   (command-s "_.UCS" "_Previous") (setq ucsChanged nil)
   (cg:restore-vars saved)
   (command-s "_.UNDO" "_End") (setq undoStarted nil)
   (setq *casa-last* model) T)))
(defun c:CASA_GERAR (/ origin model params pid)
 (if (and (cg:ensure-core) (cg:form))
  (progn
   (setq origin (getpoint "\nPonto de insercao do canto frontal esquerdo do lote: "))
   (if origin
    (progn
     (setq origin (trans origin 1 0) pid (strcat "CG-" (rtos (getvar "CDATE") 2 8) "-" (itoa (getvar "MILLISECS"))))
     (setq params (append *casa-params* (list (cons "origin_x" (car origin)) (cons "origin_y" (cadr origin)) (cons "project_id" pid))))
     (setq model (cg:generate params))
     (if (cg:get "error" model) (alert (cg:get "error" model))
      (if (cg:commit model)
       (princ "\nPlanta criada. ZOOM Extents para visualizar. CASA_EXPORTAR envia o snapshot para JSON/Revit.")))))))
 (princ))
(defun cg:stored-json (pid / entry dictionary row result)
 (setq entry (dictsearch (namedobjdict) "CASA_BH_MODELS") result nil)
 (if entry
  (progn (setq dictionary (cdr (assoc -1 entry)) entry (dictsearch dictionary pid))
   (if entry (progn (setq result "") (foreach row entry (if (= (car row) 1) (setq result (strcat result (cdr row))))))))) result)
(defun c:CASA_EXPORTAR (/ selection entity xd pid snapshot file stream)
 (setq selection (entsel "\nSelecione uma entidade da planta gerada (Enter = ultimo projeto nesta sessao): "))
 (if selection
  (progn (setq entity (car selection) xd (assoc -3 (entget entity '("CASA_BH"))))
   (if xd (setq pid (cdr (assoc 1000 (cdr (cadr xd)))))))
  (if *casa-last* (setq pid (cg:get "project_id" *casa-last*))))
 (if pid (setq snapshot (cg:stored-json pid)))
 (if snapshot
  (progn
   (setq file (getfiled "Exportar snapshot gerado - edicoes manuais nao incluidas" (strcat (getvar "DWGPREFIX") pid ".json") "json" 1))
   (if file
    (progn (setq stream (open file "w"))
     (if stream (progn (write-line snapshot stream) (close stream) (princ (strcat "\nJSON salvo: " file)))
      (alert "Nao foi possivel gravar o arquivo.")))))
  (alert "Nenhum snapshot encontrado. Selecione uma entidade CASA_BH gerada neste desenho."))
 (princ))
(defun c:CASA_AJUDA ()
 (alert "CASA_GERAR: formulario e planta. CASA_EXPORTAR: JSON para Dynamo/Revit.\nLeia README.md. Estudo preliminar em lote hipotetico; nao e projeto aprovado.\nEdicoes manuais nao atualizam o JSON. Para outra alternativa, altere a semente e gere em outro ponto.") (princ))
(princ "\nCASA BH carregado. Comandos: CASA_GERAR, CASA_EXPORTAR, CASA_AJUDA.")
(princ)

;;; CASA BH 0.4 - geometry-independent CAD presentation.
(defun cg:circle (p radius layer id)
 (cg:mk (list '(0 . "CIRCLE") (cons 8 layer) (cons 10 (append p '(0.0))) (cons 40 radius)) id))
(defun cd:legacy-furniture (item / b k id x0 x1 y0 y1 w d cx cy p)
 (setq b (cg:get "bounds" item) k (cg:get "kind" item) id (cg:get "id" item)
  x0 (nth 0 b) y0 (nth 1 b) x1 (nth 2 b) y1 (nth 3 b) w (- x1 x0) d (- y1 y0)
  cx (/ (+ x0 x1) 2.0) cy (/ (+ y0 y1) 2.0))
 (cg:rect b "CASA_MOVEIS" id)
 (cond
  ((member k '("bed" "single_bed" "double_bed" "bed_double" "bed_single"))
   (cg:rect (list (+ x0 80) (- y1 480) (- x1 80) (- y1 80)) "CASA_MOVEIS" id)
   (cg:line (list x0 (- y1 600)) (list x1 (- y1 600)) "CASA_MOVEIS" id))
  ((member k '("sofa" "armchair" "loveseat"))
   (cg:rect (list (+ x0 100) (+ y0 100) (- x1 100) (- y1 180)) "CASA_MOVEIS" id)
   (if (> w 1500) (cg:line (list cx (+ y0 100)) (list cx (- y1 180)) "CASA_MOVEIS" id)))
  ((member k '("chair" "desk_chair" "dining_chair" "office_chair"))
   (cg:line (list (+ x0 50) (- y1 100)) (list (- x1 50) (- y1 100)) "CASA_MOVEIS" id))
  ((member k '("sink" "basin" "tank" "laundry_sink"))
   (cg:rect (list (+ x0 100) (+ y0 100) (- x1 100) (- y1 100)) "CASA_MOVEIS" id)
   (cg:circle (list cx cy) 35 "CASA_MOVEIS" id))
  ((= k "toilet") (cg:circle (list cx (+ y0 (* d 0.4))) (* w 0.28) "CASA_MOVEIS" id)
   (cg:rect (list (+ x0 60) (- y1 200) (- x1 60) y1) "CASA_MOVEIS" id))
  ((member k '("stove" "cooktop"))
   (foreach p (list (list (+ x0 (* w 0.28)) (+ y0 (* d 0.28))) (list (+ x0 (* w 0.72)) (+ y0 (* d 0.28)))
    (list (+ x0 (* w 0.28)) (+ y0 (* d 0.72))) (list (+ x0 (* w 0.72)) (+ y0 (* d 0.72))))
    (cg:circle p (* (min w d) 0.12) "CASA_MOVEIS" id)))
  ((= k "washer") (cg:circle (list cx cy) (* (min w d) 0.40) "CASA_MOVEIS" id))
  ((= k "shower") (cg:line (list x0 y0) (list x1 y1) "CASA_MOVEIS" id)
   (cg:circle (list cx cy) 40 "CASA_MOVEIS" id))
  ((member k '("wardrobe" "rack" "tv_console" "tv_rack"))
   (cg:line (list cx y0) (list cx y1) "CASA_MOVEIS" id))
  ((= k "car")
   (cg:rect (list (+ x0 180) (+ y0 (* d 0.22)) (- x1 180) (- y1 (* d 0.22))) "CASA_MOVEIS" id)
   (cg:line (list (+ x0 180) (+ y0 (* d 0.45))) (list (- x1 180) (+ y0 (* d 0.45))) "CASA_MOVEIS" id)
   (cg:line (list (+ x0 180) (- y1 (* d 0.40))) (list (- x1 180) (- y1 (* d 0.40))) "CASA_MOVEIS" id))))

(defun cg:draw-furniture (item / points)
 (if (cg:get "symbol_lines" item)
  (progn
   (cg:rect (cg:get "bounds" item) "CASA_MOVEIS" (cg:get "id" item))
   (foreach points (cg:get "symbol_lines" item) (cd:polyline points nil "CASA_MOVEIS" (cg:get "id" item))))
  (cd:legacy-furniture item)))

(defun cg:draw-opening (o walls / wall c width thick horiz a b id style room box sign tip ang0 ang1)
 (setq wall (cg:find-id (cg:get "wall_id" o) walls) c (cg:get "center" o)
  width (cg:get "width" o) thick (cg:get "thickness" wall) id (cg:get "id" o)
  horiz (equal (cadr (cg:get "start" wall)) (cadr (cg:get "end" wall)) 0.01)
  style (cg:opt "door_style" o "swing"))
 (if horiz
  (setq a (list (- (car c) (/ width 2)) (cadr c)) b (list (+ (car c) (/ width 2)) (cadr c)))
  (setq a (list (car c) (- (cadr c) (/ width 2))) b (list (car c) (+ (cadr c) (/ width 2)))))
 (cond
  ((= (cg:get "kind" o) "window")
   (cg:line a b "CASA_JANELAS" id)
   (if horiz
    (progn (cg:line (list (car a) (+ (cadr a) (/ thick 2))) (list (car b) (+ (cadr b) (/ thick 2))) "CASA_JANELAS" id)
     (cg:line (list (car a) (- (cadr a) (/ thick 2))) (list (car b) (- (cadr b) (/ thick 2))) "CASA_JANELAS" id))
    (progn (cg:line (list (+ (car a) (/ thick 2)) (cadr a)) (list (+ (car b) (/ thick 2)) (cadr b)) "CASA_JANELAS" id)
     (cg:line (list (- (car a) (/ thick 2)) (cadr a)) (list (- (car b) (/ thick 2)) (cadr b)) "CASA_JANELAS" id))))
  ((= style "passage") nil)
  ((= style "sliding") (cg:line a b "CASA_PORTAS" id))
  (T
   (setq room (cg:find-id (cg:get "room_id" o) (cg:get "rooms" *cg-drawing-model*)) box (cg:get "bounds" room))
   (if horiz
    (progn
     (setq sign (if (and box (< (/ (+ (nth 1 box) (nth 3 box)) 2) (cadr c))) -1 1)
      tip (list (car a) (+ (cadr a) (* sign width))))
     (if (= sign 1) (setq ang0 0.0 ang1 (/ pi 2)) (setq ang0 (* 1.5 pi) ang1 (* 2 pi))))
    (progn
     (setq sign (if (and box (< (/ (+ (nth 0 box) (nth 2 box)) 2) (car c))) -1 1)
      tip (list (+ (car a) (* sign width)) (cadr a)))
     (if (= sign 1) (setq ang0 0.0 ang1 (/ pi 2)) (setq ang0 (/ pi 2) ang1 pi))))
   (cg:line a tip "CASA_PORTAS" id)
   (cg:mk (list '(0 . "ARC") '(8 . "CASA_PORTAS") (cons 10 (append a '(0.0)))
    (cons 40 width) (cons 50 ang0) (cons 51 ang1)) id))))

(defun cg:label-box (item / b id txt w h tw th px py cand best score bestscore f fb dims)
 (setq b (cg:get "bounds" item) id (cg:get "id" item) txt (cg:opt "name" item (cg:get "kind" item))
  w (- (nth 2 b) (car b)) h (- (nth 3 b) (cadr b)) tw (min (- w 100) (max 1150 (* 82 (strlen txt)))) th 620 best nil bestscore 1e20)
 (foreach cand '((0.5 0.5) (0.5 0.4) (0.5 0.7) (0.25 0.45) (0.75 0.45) (0.5 0.15) (0.5 0.85))
  (setq px (+ (car b) (* (- w tw) (car cand))) py (+ (cadr b) (* (- h th) (cadr cand)))
   fb (list px py (+ px tw) (+ py th)) score 0)
  (foreach f (cg:get "furniture" *cg-drawing-model*)
   (if (cf:hit fb (cg:get "bounds" f)) (setq score (+ score 1))))
  (foreach f (cf:doors b *cg-drawing-model*) (if (cf:hit fb f) (setq score (+ score 1))))
  (if (< score bestscore) (setq best (list px py) bestscore score)))
 (setq *cj-label-boxes* (cons (list (car best) (cadr best) (+ (car best) tw) (+ (cadr best) th)) *cj-label-boxes*))
 (cg:text (list (car best) (+ (cadr best) 430)) txt 140 "CASA_TEXTOS" id)
 (cg:text (list (car best) (+ (cadr best) 220)) (strcat (rtos (/ (* w h) 1e6) 2 2) " m2") 120 "CASA_TEXTOS" id)
 (cg:text best (strcat (rtos (/ w 1000.0) 2 2) " x " (rtos (/ h 1000.0) 2 2) " m") 110 "CASA_TEXTOS" id))

(defun cg:draw-model (model / site house walls rooms zones item b id x0 y0 x1 y1 tx yy area cutY a z ht wt xs v c width sill nx ny angle endp widthpairs pair dimy sidepos host)
 (setq *cj-label-boxes* nil *cg-drawing-model* model site (cg:get "site_bounds" model) house (cg:get "house_bounds" model)
  walls (cg:get "walls" model) rooms (cg:get "rooms" model) zones (cg:get "zones" model)
  x0 (nth 0 house) y0 (nth 1 house) x1 (nth 2 house) y1 (nth 3 house))
 (foreach item '(("CASA_LOTE" 8) ("CASA_PAREDES" 7) ("CASA_PORTAS" 2) ("CASA_JANELAS" 4)
  ("CASA_MOVEIS" 3) ("CASA_TEXTOS" 7) ("CASA_COTAS" 6) ("CASA_ESTUDO" 8) ("CASA_EXTERNO" 3) ("CASA_COBERTURA" 2) ("CASA_ACESSO" 4))
  (cg:layer (car item) (cadr item)))
 (cg:rect site "CASA_LOTE" "SITE")
 (foreach item (cg:get "outdoor" model) (cg:rect (cg:get "bounds" item) "CASA_EXTERNO" (cg:get "id" item)) (cg:label-box item))
 (if (cg:get "entry_path" model)
  (progn
   (cd:polyline (cg:get "points" (cg:get "entry_path" model)) nil "CASA_ACESSO" "ENTRY-PATH")
   (setq a (car (cg:get "points" (cg:get "entry_path" model))))
   (cg:text (list (+ (car a) 200) (+ (cadr a) 250))
    (strcat "Acesso " (rtos (/ (cg:get "length" (cg:get "entry_path" model)) 1000.0) 2 2) " m") 120 "CASA_TEXTOS" "ENTRY-PATH")))
 (cj:draw model)
 (foreach item (cg:get "openings" model) (cg:draw-opening item walls))
 (foreach item (cg:get "furniture" model) (cg:draw-furniture item))
 (foreach item rooms
  (if (not (member (cg:get "kind" item) '("social" "corridor"))) (cg:label-box item)))
 (foreach item zones
  (setq host (cg:find-id (cg:get "room_id" item) rooms))
  (if (and host (= (cg:get "kind" host) "social")) (cg:label-box item)))
 (cj:dimensions model)
 (setq tx (+ (nth 2 site) 3300) yy (nth 3 site) area 0)
 (cg:text (list tx yy) "CASA BH 0.4 | ESTUDO PRELIMINAR" 280 "CASA_TEXTOS" "TITLE")
 (setq yy (- yy 480))
 (cg:text (list tx yy) (strcat (cg:opt "layout_name" model "Alternativa") " | " (cg:opt "integration_name" model "")) 190 "CASA_TEXTOS" "TITLE")
 (setq yy (- yy 380))
 (cg:text (list tx yy) (strcat "Semente " (itoa (fix (cg:get "seed" model))) " | " (cg:get "project_id" model)) 160 "CASA_TEXTOS" "TITLE")
 (foreach item rooms
  (setq yy (- yy 330) area (+ area (cg:get "net_area_m2" item)))
  (cg:text (list tx yy) (strcat (cg:get "name" item) ": " (rtos (cg:get "net_area_m2" item) 2 2) " m2") 170 "CASA_TEXTOS" "SCHEDULE"))
 (setq yy (- yy 450))
 (cg:text (list tx yy) (strcat "Util " (rtos area 2 2) " m2 | Casa " (rtos (cg:get "gross_area_m2" model) 2 2) " m2") 175 "CASA_TEXTOS" "SCHEDULE")
 (setq yy (- yy 350))
 (cg:text (list tx yy) (strcat "Circulacao: " (rtos (cg:opt "circulation_area_m2" model 0) 2 2) " m2 ("
  (rtos (* 100 (cg:opt "circulation_fraction" model 0)) 2 1) "% da area util)") 160 "CASA_TEXTOS" "METRICS")
 (setq yy (- yy 300))
 (cg:text (list tx yy) (strcat "Janelas: " (itoa (fix (cg:opt "windows_count" model 0))) " | Area geometrica: "
  (rtos (cg:opt "window_area_m2" model 0) 2 2) " m2") 160 "CASA_TEXTOS" "METRICS")
 (foreach item (cg:get "validations" model)
  (setq yy (- yy 300))
  (cg:text (list tx yy) (strcat (cg:get "rule_id" item) ": " (cg:get "status" item)) 150 "CASA_TEXTOS" "CHECK"))
 (foreach item '("Estudo hipotetico. Faixas livres nao sao recuos legais de BH."
   "Cotas em metros. Garagem descoberta. Cobertura conceitual em laje."
   "Conforto: indicadores geometricos; desempenho nao simulado."
   "Revit recebe geracao; edicoes manuais CAD nao sincronizadas.")
  (setq yy (- yy 300)) (cg:text (list tx yy) item 150 "CASA_TEXTOS" "NOTES"))
 ;; North convention: clockwise from +Y, independent of CAD UCS.
 (setq nx (+ (nth 2 site) 1500) ny (- (nth 3 site) 2300)
  angle (* (/ pi 180.0) (cg:opt "north_degrees" model (cg:opt "north" model 0.0)))
  endp (list (+ nx (* 1500 (sin angle))) (+ ny (* 1500 (cos angle)))))
 (cg:line (list nx ny) endp "CASA_ESTUDO" "NORTH")
 (cg:circle endp 90 "CASA_ESTUDO" "NORTH")
 (cg:text (list (+ (car endp) 120) (+ (cadr endp) 120)) "N*" 220 "CASA_TEXTOS" "NORTH")
 (cg:text (list tx (- yy 380)) "* Norte informado; confirmar no levantamento." 150 "CASA_TEXTOS" "NORTH")
 (cd:sections model tx yy)
 (princ))

(defun c:CASA_ALTERNATIVAS (/ origin params model index seed pid ok step)
 (if (and (cg:ensure-core) (cg:form))
  (progn (setq origin (getpoint "\nPonto inicial para comparar tres organizacoes: "))
   (if origin
    (progn (setq origin (trans origin 1 0) index 1 ok 0 seed (fix (cg:get "seed" *casa-params*))
      step (+ (cg:get "lot_width" *casa-params*) 28000))
     (repeat 3
      (setq pid (strcat "CG3-" (itoa (getvar "MILLISECS")) "-" (itoa index))
       params (append (list (cons "layout" index) (cons "seed" seed)
        (cons "origin_x" (+ (car origin) (* (1- index) step))) (cons "origin_y" (cadr origin)) (cons "project_id" pid)) *casa-params*)
       model (cg:generate params))
      (if (cg:get "error" model) (princ (strcat "\nAlternativa " (itoa index) ": " (cg:get "error" model)))
       (if (cg:commit model) (setq ok (1+ ok))))
      (setq index (1+ index)))
     (princ (strcat "\n" (itoa ok) " alternativas desenhadas. CASA_EXPORTAR: selecione a alternativa desejada."))))))
 (princ))
(defun c:CASA_AJUDA ()
 (alert "CASA_GERAR: uma alternativa. CASA_ALTERNATIVAS: compara tres organizacoes.\nCASA_EXPORTAR: snapshot JSON para Revit.\nUse Modelo, INSUNITS=4. Leia LEIA-ME.md.\nRegras municipais e desempenho ambiental ainda pendentes.") (princ))
(princ "\nCASA BH 0.4: CASA_GERAR, CASA_ALTERNATIVAS, CASA_EXPORTAR.") (princ)

(defun ce:raise (message) (princ (strcat "\n" message)) (exit))
;;; CASA BH: persisted furniture dimensions. No executable data in JSON parser.
(defun ce:put (k v obj) (if (assoc k obj) (subst (cons k v) (assoc k obj) obj) (append obj (list (cons k v)))))
(defun cj:space () (while (and (<= cj:i cj:n) (member (ascii (substr cj:s cj:i 1)) '(9 10 13 32))) (setq cj:i (1+ cj:i))))
(defun cj:expect (s) (cj:space) (if (/= (substr cj:s cj:i 1) s) (ce:raise "JSON invalido.")) (setq cj:i (1+ cj:i)))
(defun cj:string (/ out c hex n j code)
 (cj:expect "\"") (setq out "" c "")
 (while (and (<= cj:i cj:n) (/= (setq c (substr cj:s cj:i 1)) "\""))
  (setq cj:i (1+ cj:i))
  (if (= c "\\")
   (progn (setq c (substr cj:s cj:i 1) cj:i (1+ cj:i))
    (cond ((= c "n") (setq c (chr 10))) ((= c "r") (setq c (chr 13))) ((= c "t") (setq c (chr 9)))
     ((= c "b") (setq c (chr 8))) ((= c "f") (setq c (chr 12)))
     ((= c "u") (setq hex (strcase (substr cj:s cj:i 4)) n 0 j 1)
      (repeat 4 (setq code (vl-string-search (substr hex j 1) "0123456789ABCDEF"))
       (if (null code) (ce:raise "Escape JSON invalido.")) (setq n (+ (* n 16) code) j (1+ j)))
      (setq c (chr n) cj:i (+ cj:i 4)))
     ((not (member c '("\"" "\\" "/"))) (ce:raise "Escape JSON invalido.")))))
  (setq out (strcat out c)))
 (cj:expect "\"") out)
(defun cj:value (/ c out key start token val)
 (cj:space) (setq c (substr cj:s cj:i 1))
 (cond ((= c "\"") (cj:string))
  ((member c '("[" "{"))
   (setq cj:i (1+ cj:i) out nil) (cj:space)
   (if (/= (substr cj:s cj:i 1) (if (= c "[") "]" "}"))
    (progn
     (if (= c "{") (progn (setq key (cj:string)) (cj:expect ":") (setq val (cons key (cj:value)))) (setq val (cj:value)))
     (setq out (list val)) (cj:space)
     (while (= (substr cj:s cj:i 1) ",")
      (setq cj:i (1+ cj:i))
      (if (= c "{") (progn (setq key (cj:string)) (cj:expect ":") (setq val (cons key (cj:value)))) (setq val (cj:value)))
      (setq out (cons val out)) (cj:space))))
   (cj:expect (if (= c "[") "]" "}")) (reverse out))
  (T (setq start cj:i)
   (while (and (<= cj:i cj:n) (not (member (substr cj:s cj:i 1) '(" " "\t" "\r" "\n" "," "]" "}")))) (setq cj:i (1+ cj:i)))
   (setq token (substr cj:s start (- cj:i start)))
   (cond ((= token "true") 'cj:true) ((= token "false") 'cj:false) ((= token "null") 'cj:null)
    ((and (> (strlen token) 0) (not (wcmatch token "*[~0-9.eE+-]*")) (setq val (distof token 2))) val)
    (T (ce:raise "Numero JSON invalido."))))))
(defun cj:parse (text / cj:s cj:i cj:n val)
 (setq cj:s text cj:i 1 cj:n (strlen text) val (cj:value)) (cj:space)
 (if (<= cj:i cj:n) (ce:raise "Conteudo apos JSON.")) val)
(defun ce:identity (entity / xd)
 (setq xd (cdr (cadr (assoc -3 (entget entity '("CASA_BH"))))))
 (if (and xd (= (caar xd) 1000) (= (car (cadr xd)) 1000)) (list (cdar xd) (cdr (cadr xd)))))
(defun ce:entities (pid id / ss i out en)
 (setq ss (ssget "_X" '((-3 ("CASA_BH")))) i 0 out nil)
 (if ss (repeat (sslength ss) (setq en (ssname ss i) i (1+ i))
  (if (equal (ce:identity en) (list pid id)) (setq out (cons en out))))) out)
(defun ce:save (model / dict rec data str chunks i fresh pid)
 (setq dict (cdr (assoc -1 (dictsearch (namedobjdict) "CASA_BH_MODELS")))
  rec (dictsearch dict (cg:get "project_id" model)))
 (if (not rec) (ce:raise "Snapshot do projeto ausente."))
 (setq data (vl-remove-if '(lambda (p) (= (car p) 1)) (entget (cdr (assoc -1 rec)))) str (cg:json model) chunks nil i 1)
 (while (<= i (strlen str)) (setq chunks (cons (cons 1 (substr str i 240)) chunks) i (+ i 240)))
 ;; XRECORD entmod appends payload in AutoCAD 2027. Replace the owned record
 ;; inside the same UNDO group, rather than concatenating two JSON documents.
 (setq pid (cg:get "project_id" model)
  fresh (entmakex (append '((0 . "XRECORD") (100 . "AcDbXrecord") (280 . 1)) (reverse chunks))))
 (if (not fresh) (ce:raise "Falha ao criar snapshot."))
 (if (not (dictremove dict pid)) (ce:raise "Falha ao liberar snapshot anterior."))
 (if (not (dictadd dict pid fresh)) (ce:raise "Falha ao registrar snapshot atualizado."))
 (if (entget (cdr (assoc -1 rec))) (entdel (cdr (assoc -1 rec)))))
(defun ce:point (p old new)
 (list (+ (car new) (* (- (car p) (car old)) (/ (- (nth 2 new) (car new)) (- (nth 2 old) (car old)))))
       (+ (cadr new) (* (- (cadr p) (cadr old)) (/ (- (nth 3 new) (cadr new)) (- (nth 3 old) (cadr old)))))))
(defun ce:resize (item width depth height / old new use dx dy angle lines result original ln)
 (setq old (cg:get "bounds" item) angle (cg:opt "rotation" item 0) original (cg:opt "source_bounds_before_edit" item old))
 (if (member angle '(90 270)) (setq dx depth dy width) (setq dx width dy depth))
 (if (or (< dx (max 250 (* 0.65 (- (nth 2 original) (car original)))) )
         (< dy (max 250 (* 0.65 (- (nth 3 original) (cadr original)))) ) (< height 100) (> height 3000))
  (ce:raise "Medidas fora da faixa do modelo: minimo 65% da base/250 mm; altura 100 a 3000 mm."))
 (setq new (list (- (/ (+ (car old) (nth 2 old)) 2.0) (/ dx 2.0)) (- (/ (+ (cadr old) (nth 3 old)) 2.0) (/ dy 2.0))
                 (+ (/ (+ (car old) (nth 2 old)) 2.0) (/ dx 2.0)) (+ (/ (+ (cadr old) (nth 3 old)) 2.0) (/ dy 2.0)))
  use (cg:opt "use_bounds" item old) lines nil)
 (foreach ln (cg:get "symbol_lines" item) (setq lines (cons (mapcar '(lambda (p) (ce:point p old new)) ln) lines)))
 (setq result (ce:put "bounds" new item) result (ce:put "height" height result)
  result (ce:put "use_bounds" (mapcar '+ new (mapcar '- use old)) result)
  result (ce:put "symbol_lines" (reverse lines) result)
  result (ce:put "source_bounds_before_edit" original result)
  result (ce:put "dimension_revision" (1+ (cg:opt "dimension_revision" item 0)) result)) result)
(defun ce:validate (item model / host box others reason f door)
 (setq host (cg:find-id (cg:get "room_id" item) (append (cg:get "rooms" model) (cg:get "outdoor" model)))
  box (if host (cg:get "bounds" host)) reason nil)
 (cond ((not box) (setq reason "Ambiente do movel nao identificado."))
  ((not (and (cf:inside (cg:get "bounds" item) box) (cf:inside (cg:get "use_bounds" item) box))) (setq reason "Movel ou faixa de uso invade a parede/limite do ambiente.")))
 (foreach f (cg:get "furniture" model)
  (if (/= (cg:get "id" f) (cg:get "id" item))
   (if (or (cf:hit (cg:get "bounds" item) (cg:get "bounds" f))
      (and (not (and (member (cg:get "kind" item) '("bed_double" "bed_single")) (= (cg:get "kind" f) "nightstand"))) (cf:hit (cg:get "use_bounds" item) (cg:get "bounds" f)))
      (and (not (and (member (cg:get "kind" f) '("bed_double" "bed_single")) (= (cg:get "kind" item) "nightstand"))) (cf:hit (cg:get "use_bounds" f) (cg:get "bounds" item))))
    (setq reason (strcat "Conflito com movel/faixa de uso: " (cg:get "id" f))))))
 (if box (foreach door (cf:doors box model) (if (cf:hit (cg:get "bounds" item) door) (setq reason "Conflito com abertura de porta."))))
 (if (not (cf:window-clear (list item) model)) (setq reason "Altura/posicao bloqueia janela."))
 (if (> (cg:get "height" item) (cg:get "height" (car (cg:get "walls" model)))) (setq reason "Movel acima do pe-direito.")) reason)
(defun ce:apply (model item / *error* undoStarted entities en old b poly *cg-pid* *cg-drawing-model* newmodel)
 (setq *cg-pid* (cg:get "project_id" model) *cg-drawing-model* model undoStarted nil
  entities (ce:entities *cg-pid* (cg:get "id" item)) old (cg:find-id (cg:get "id" item) (cg:get "furniture" model)) b (cg:get "bounds" old))
 (defun *error* (message)
  (if undoStarted (progn (command-s "_.UNDO" "_End") (command-s "_.U"))) (princ (strcat "\nEdicao cancelada: " message)) (princ))
 (if (not entities) (ce:raise "Geometria do movel ausente."))
 ;; Outline signature detects moved/scaled outlines before regenerating symbols.
 (setq poly nil)
 (foreach en entities
  (if (= (cdr (assoc 0 (entget en))) "LWPOLYLINE")
   (if (equal (mapcar 'cdr (vl-remove-if-not '(lambda (p) (= (car p) 10)) (entget en)))
     (list (list (car b) (cadr b)) (list (nth 2 b) (cadr b)) (list (nth 2 b) (nth 3 b)) (list (car b) (nth 3 b))) 0.1) (setq poly T)))
  (if (= 4 (logand 4 (cdr (assoc 70 (tblsearch "LAYER" (cdr (assoc 8 (entget en)))))))) (ce:raise "Camada de movel bloqueada.")))
 (if (not poly) (ce:raise "Contorno alterado manualmente. Desfaca MOVE/SCALE antes de editar parametros."))
 (setq newmodel (ce:put "furniture" (mapcar '(lambda (f) (if (= (cg:get "id" f) (cg:get "id" item)) item f)) (cg:get "furniture" model)) model))
 (command-s "_.UNDO" "_Begin") (setq undoStarted T)
 (foreach en entities (if (not (entdel en)) (ce:raise "Falha ao remover simbolo anterior.")))
 (cg:draw-furniture item) (ce:save newmodel)
 (command-s "_.UNDO" "_End") (setq undoStarted nil *casa-last* newmodel) newmodel)
(defun c:CASA_MOVEL_EDITAR (/ *error* selection ids model item b width depth height changed reason)
 (defun *error* (message) (princ (strcat "\nEdicao cancelada: " message)) (princ))
 (setq selection (entsel "\nSelecione uma linha do movel CASA: "))
 (if selection
  (progn
   (setq ids (ce:identity (car selection))) (if (not ids) (ce:raise "Selecione um movel gerado pelo CASA."))
   (setq model (cj:parse (cg:stored-json (car ids))) item (cg:find-id (cadr ids) (cg:get "furniture" model)))
   (if (not item) (ce:raise "Entidade nao e movel do projeto."))
   (setq b (cg:get "bounds" item) width (- (nth 2 b) (car b)) depth (- (nth 3 b) (cadr b)) height (cg:get "height" item))
   (if (member (cg:opt "rotation" item 0) '(90 270)) (setq width (- (nth 3 b) (cadr b)) depth (- (nth 2 b) (car b))))
   (princ (strcat "\n" (cg:get "id" item) " | " (cg:get "kind" item) " | Medidas locais em METROS. Centro e orientacao preservados."))
   (initget 6) (setq width (* 1000 (cond ((getreal (strcat "\nLargura <" (rtos (/ width 1000.0) 2 3) ">: "))) (T (/ width 1000.0)))))
   (initget 6) (setq depth (* 1000 (cond ((getreal (strcat "\nProfundidade <" (rtos (/ depth 1000.0) 2 3) ">: "))) (T (/ depth 1000.0)))))
   (initget 6) (setq height (* 1000 (cond ((getreal (strcat "\nAltura <" (rtos (/ height 1000.0) 2 3) ">: "))) (T (/ height 1000.0)))))
   (setq changed (ce:resize item width depth height) reason (ce:validate changed model))
   (if reason (ce:raise reason))
   (if (ce:apply model changed) (princ "\nMovel e snapshot atualizados. Salve o DWG e use CASA_EXPORTAR para enviar as medidas ao Revit.")))) (princ))
(princ "\nCASA_MOVEL_EDITAR: dimensoes de moveis em metros, com exportacao para Revit.") (princ)
