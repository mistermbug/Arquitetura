(defun cf:inside (a b) (and (>= (car a) (- (car b) 0.1)) (>= (cadr a) (- (cadr b) 0.1)) (<= (nth 2 a) (+ (nth 2 b) 0.1)) (<= (nth 3 a) (+ (nth 3 b) 0.1))))
